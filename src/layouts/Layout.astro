---
import '../styles/global.scss';
import Icon from '../components/Icon.astro';
interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}
const {
  title = 'Thoughtful tools. All in one place.',
  description = 'Discover extensions, packages, and open source projects by kirasync2748 and friends. A little place for big ideas.',
  noindex = false,
} = Astro.props;
const path = Astro.url.pathname;
const canonical = import.meta.env.SITE_URL
  ? new URL(path, import.meta.env.SITE_URL).href
  : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="theme-color" content="#f5f7fc" />
    <title>{title} · Kira Store</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={`${title} · Kira Store`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.svg" />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <div class="ambient" aria-hidden="true"></div>
    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="brand" aria-label="Kira Store home">
          <span class="brand-mark">K</span>
          <span>
            kira<span class="brand-muted">.store</span>
          </span>
        </a>
        <nav aria-label="Main navigation">
          <a href="/" aria-current={path === '/' ? 'page' : undefined}>
            Discover
          </a>
          <a href="/projects" aria-current={path.startsWith('/projects') ? 'page' : undefined}>
            Catalog
          </a>
          <a
            href="/repositories"
            aria-current={path.startsWith('/repositories') ? 'page' : undefined}
          >
            Repositories
          </a>
          <a href="/about" aria-current={path === '/about' ? 'page' : undefined}>
            About
          </a>
        </nav>
        <a
          class="header-action"
          aria-label="Meet kirasync2748 on GitHub"
          href="https://github.com/kirasync2748"
          target="_blank"
          rel="noopener noreferrer"
        >
          <Icon name="github" size={18} />
          <span>Meet the maker</span>
          <Icon name="arrow" size={14} />
        </a>
      </div>
    </header>
    <main id="main" class="container">
      <slot />
    </main>
    <footer class="site-footer container">
      <div>
        <a class="brand" href="/">
          <span class="brand-mark small">K</span>kira.store
        </a>
        <p>Small tools. A world of possibilities.</p>
      </div>
      <div class="footer-links">
        <a href="/about">About</a>
        <a href="/status">Source status</a>
        <a href="/privacy">Privacy</a>
        <a href="https://github.com/kirasync2748" target="_blank" rel="noopener noreferrer">
          GitHub ↗
        </a>
      </div>
      <span class="copyright">Made with care · {new Date().getFullYear()}</span>
    </footer>
    <script>
      document.querySelectorAll<HTMLImageElement>('.app-icon img').forEach((img) => {
        const fail = () => img.remove();
        img.addEventListener('error', fail);
        if (img.complete && img.naturalWidth === 0) fail();
      });
    </script>
  </body>
</html>
