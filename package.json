{
  "name": "kira-store",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.x",
    "bun": ">=1.4.2"
  },
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "check": "astro check",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "build": "astro build",
    "build:vercel": "DEPLOY_TARGET=vercel astro build && node scripts/set-vercel-runtime.mjs",
    "build:cloudflare": "DEPLOY_TARGET=cloudflare astro build",
    "start": "node dist/server/entry.mjs",
    "preview": "astro preview --host 0.0.0.0",
    "deploy:cloudflare": "npm run build:cloudflare && wrangler deploy",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "astro": "7.4.11",
    "fast-xml-parser": "5.12.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/cloudflare": "14.4.7",
    "@astrojs/node": "11.1.12",
    "@astrojs/vercel": "11.0.21",
    "@types/node": "26.6.6",
    "prettier": "3.10.1",
    "prettier-plugin-astro": "1.1.2",
    "sass": "1.108.2",
    "typescript": "6.0.3",
    "wrangler": "4.160.1"
  },
  "overrides": {
    "glob": "14.0.5",
    "minimatch": "11.0.8",
    "path-to-regexp": "6.3.0"
  }
}
